# /etc/tela-p2p-internet.env — configuração do servidor do modo Internet
PORT=8765
# TROQUE: IP público da VPS (o mesmo do external-ip do turnserver.conf)
TURN_HOST=IP_DA_VPS
TURN_PORT=3479
# TROQUE: o mesmo static-auth-secret do turnserver.conf (openssl rand -hex 32)
TURN_SECRET=SEGREDO_DO_TURN
# Quanto tempo vale o acesso ao TURN que cada pessoa recebe ao entrar (segundos)
TURN_TTL_SECONDS=86400
# Opcional: TURN da Cloudflare (Realtime TURN, 1.000 GB/mês grátis). Com os dois preenchidos, a sala entrega o TURN
# da Cloudflare e o coturn acima fica só de reserva (o relay pela VPS gasta o tráfego dela). Painel: Realtime > TURN.
# O instalar.sh guarda estas linhas quando roda de novo.
#CF_TURN_KEY_ID=
#CF_TURN_API_TOKEN=
#CF_TURN_TTL_SECONDS=86400
# Limites
MAX_ROOMS=200
FAIL_PER_IP=10
# 1 só se este servidor ficar atrás do Caddy/nginx (wss://). Só vale para conexões de rede privada (o proxy); de fora o X-Forwarded-For é ignorado.
TRUST_PROXY=0
